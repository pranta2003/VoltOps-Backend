# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# Get a free PostgreSQL database from https://neon.tech or https://supabase.com
# It will look like: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Any long random string. You can generate one at https://www.random.org/strings/
JWT_SECRET="replace-this-with-a-long-random-secret-string"

# How long a login token stays valid
JWT_EXPIRES_IN="7d"

# Port the backend server runs on
PORT=5000

# The URL of your frontend (used for CORS). Update this when you deploy.
FRONTEND_URL="http://localhost:5173"
